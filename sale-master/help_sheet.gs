/**
 * ============================================================
 * 「📖 使い方」シートを作る
 * ============================================================
 *
 * Apps Script に貼り付けて、関数 createHelpSheet を1回実行するだけ。
 * このスプレッドシートの一番左に、整形済みの説明タブができる。
 *
 * 内容を直したいときは、下の HELP_ROWS を書き換えてもう一度実行する
 * （シートは毎回作り直されるので、シート上で直接編集した内容は消える点に注意）。
 * ============================================================
 */

const HELP_SHEET_NAME = '📖 使い方';

/** 説明シートを作り直す */
function createHelpSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const old = ss.getSheetByName(HELP_SHEET_NAME);
  if (old) ss.deleteSheet(old);

  const sheet = ss.insertSheet(HELP_SHEET_NAME, 0);
  const rows = HELP_ROWS();

  // 値をまとめて書き込む（1行ずつ書くと遅いので）
  const values = rows.map(r => [r[1] || '', r[2] || '', r[3] || '']);
  sheet.getRange(1, 1, values.length, 3).setValues(values);

  sheet.setColumnWidth(1, 240);
  sheet.setColumnWidth(2, 130);
  sheet.setColumnWidth(3, 620);
  sheet.setHiddenGridlines(true);

  const all = sheet.getRange(1, 1, values.length, 3);
  all.setFontFamily('Noto Sans JP').setFontSize(10)
    .setVerticalAlignment('top').setWrap(true);

  // 行ごとに見た目を当てる
  rows.forEach((r, i) => {
    const n = i + 1;
    const row = sheet.getRange(n, 1, 1, 3);
    switch (r[0]) {
      case 'h1':
        sheet.getRange(n, 1, 1, 3).merge();
        row.setFontSize(16).setFontWeight('bold').setFontColor('#0E7A55');
        sheet.setRowHeight(n, 34);
        break;
      case 'h2':
        sheet.getRange(n, 1, 1, 3).merge();
        row.setFontSize(12).setFontWeight('bold').setFontColor('#ffffff')
          .setBackground('#0E7A55');
        sheet.setRowHeight(n, 28);
        break;
      case 'p':
        sheet.getRange(n, 1, 1, 3).merge();
        row.setFontColor('#333333');
        break;
      case 'note':
        sheet.getRange(n, 1, 1, 3).merge();
        row.setFontColor('#8A6D00').setBackground('#FFFBE8').setFontSize(9);
        break;
      case 'warn':
        sheet.getRange(n, 1, 1, 3).merge();
        row.setFontColor('#B3261E').setBackground('#FDECEA').setFontWeight('bold');
        break;
      case 'th':
        row.setFontWeight('bold').setBackground('#EFF7F3').setFontColor('#0E7A55');
        break;
      case 'tr':
        sheet.getRange(n, 1).setFontWeight('bold');
        break;
      case 'gap':
        sheet.setRowHeight(n, 10);
        break;
    }
  });

  sheet.setFrozenRows(1);
  ss.setActiveSheet(sheet);
  SpreadsheetApp.getUi().alert('「' + HELP_SHEET_NAME + '」シートを作りました',
    '一番左のタブです。', SpreadsheetApp.getUi().ButtonSet.OK);
}

